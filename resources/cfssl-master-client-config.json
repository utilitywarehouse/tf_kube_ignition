{
    "signing": {
        "default": {
            "auth_remote": {
                "remote": "server",
                "auth_key": "master-auth"
            }
        }
    },
    "auth_keys": {
        "master-auth": {
            "type": "standard",
            "key": "${cfssl_master_auth_key}"
        }
    },
    "remotes": {
        "server": "${cfssl_server_endpoint}"
    }
}
