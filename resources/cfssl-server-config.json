{
    "signing": {
        "default": {
            "auth_key": "unused",
            "expiry": "${expiry_hours}h"
        },
        "profiles": {
            "client": {
                "expiry": "${expiry_hours}h",
                "usages": [
                    "signing",
                    "key encipherment",
                    "client auth"
                ],
                "auth_key": "client"
            },
            "client-server": {
                "expiry": "${expiry_hours}h",
                "usages": [
                    "signing",
                    "key encipherment",
                    "server auth",
                    "client auth"
                ],
                "auth_key": "client"
            },
            "worker-client": {
                "expiry": "${expiry_hours}h",
                "usages": [
                    "signing",
                    "key encipherment",
                    "client auth"
                ],
                "auth_key": "worker-auth",
                "name_whitelist": "^(system:node:.*|system:kubelet:.*|[^:]+)$"
            },
            "worker-client-server": {
                "expiry": "${expiry_hours}h",
                "usages": [
                    "signing",
                    "key encipherment",
                    "server auth",
                    "client auth"
                ],
                "auth_key": "worker-auth",
                "name_whitelist": "^(system:node:.*|system:kubelet:.*|[^:]+)$"
            },
            "master-client-server": {
                "expiry": "${expiry_hours}h",
                "usages": [
                    "signing",
                    "key encipherment",
                    "server auth",
                    "client auth"
                ],
                "auth_key": "master-auth",
                "name_whitelist": "^(system:node:.*|system:kubelet:.*|system:kube-scheduler|system:kube-controller-manager|[^:]+)$"
            },
            "apiserver-client-server": {
                "expiry": "${expiry_hours}h",
                "usages": [
                    "signing",
                    "key encipherment",
                    "server auth",
                    "client auth"
                ],
                "auth_key": "master-auth",
                "name_whitelist": "^(system:node:.*|system:kube-apiserver-kubelet-client|kubernetes.*|localhost|[^:]+)$"
            },
            "etcd-client-server": {
                "expiry": "${expiry_hours}h",
                "usages": [
                    "signing",
                    "key encipherment",
                    "server auth",
                    "client auth"
                ],
                "auth_key": "etcd-auth",
                "name_whitelist": "^([0-9]+\\.etcd\\..*|etcd\\..*|[^:]+)$"
            }
        }
    },
    "auth_keys": {
        "client": {
            "type": "standard",
            "key": "${cfssl_auth_key}"
        },
        "unused": {
            "type": "standard",
            "key": "${cfssl_unused_key}"
        },
        "worker-auth": {
            "type": "standard",
            "key": "${cfssl_worker_auth_key}"
        },
        "master-auth": {
            "type": "standard",
            "key": "${cfssl_master_auth_key}"
        },
        "etcd-auth": {
            "type": "standard",
            "key": "${cfssl_etcd_auth_key}"
        }
    }
}
